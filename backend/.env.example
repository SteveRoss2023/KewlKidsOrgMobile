# Copy to .env. Do not commit real secrets.

SECRET_KEY=
DEBUG=True

# IANA timezone for checklist→calendar event start times (8am wall clock). Override if needed.
# Default in settings.py is America/Edmonton (Canadian Mountain). Examples: America/Toronto, America/Vancouver, America/Creston (MST year-round).
# CHECKLIST_CALENDAR_TIME_ZONE=America/Edmonton

DATABASE_NAME=KewlKidsOrganizerMobile
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

FERNET_KEY=

# Public web app (browser), no trailing slash
WEB_APP_URL=https://organizer.kewlkids.ca

# Public API origin (scheme + host, no path, no trailing slash). Recipe media + profile photo URLs in JSON use this
# so phones never get http://127.0.0.1:8900/... when your browser calls Django on loopback.
API_PUBLIC_BASE_URL=https://organizer-api.kewlkids.ca

# OAuth redirect URIs must match provider consoles (use your public API host)
MICROSOFT_REDIRECT_URI=https://organizer-api.kewlkids.ca/api/calendar/outlook/oauth/callback/
ONEDRIVE_REDIRECT_URI_DEV=http://localhost:8900/api/onedrive/oauth/callback/
ONEDRIVE_REDIRECT_URI_PROD=https://organizer-api.kewlkids.ca/api/onedrive/oauth/callback/
GOOGLEDRIVE_REDIRECT_URI_DEV=http://localhost:8900/api/googledrive/oauth/callback/
GOOGLEDRIVE_REDIRECT_URI_PROD=https://organizer-api.kewlkids.ca/api/googledrive/oauth/callback/
GOOGLE_PHOTOS_REDIRECT_URI_DEV=http://localhost:8900/api/googlephotos/oauth/callback/
GOOGLE_PHOTOS_REDIRECT_URI_PROD=https://organizer-api.kewlkids.ca/api/googlephotos/oauth/callback/
